# Application (public)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Company defaults (public; do not place secrets in NEXT_PUBLIC_* variables)
NEXT_PUBLIC_COMPANY_NAME=Roadside Assistance Co.
NEXT_PUBLIC_COMPANY_PHONE=+1 555 010 2020
NEXT_PUBLIC_COMPANY_EMAIL=support@example.com

# Supabase Auth and browser client (public, RLS-protected)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase privileged server access (server only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Maps browser key (public; restrict by HTTP referrer and API)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-browser-key
NEXT_PUBLIC_GOOGLE_MAP_ID=DEMO_MAP_ID
# Google Maps server key (server only; restrict by API and server origin/IP)
GOOGLE_MAPS_SERVER_API_KEY=your-server-key

# Upstash Redis (server only)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token

# Stripe (publishable key is public; all others are server only)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Twilio Verify (server only)
TWILIO_ACCOUNT_SID=AC_replace_me
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_VERIFY_SERVICE_SID=VA_replace_me

# Resend (server only)
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=Roadside Assistance <bookings@example.com>
